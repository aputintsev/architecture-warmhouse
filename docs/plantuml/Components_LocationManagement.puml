@startuml
title Location Management Component Diagram

top to bottom direction

!include <C4/C4_Component>

Container_Boundary(smartHomeSystem, "SmartHome System") {
    Container(loadBalancer, "Балансировщик нагрузки", "Балансирует соединения")
    Container(scenarioEngine, "Движок сценариев", "Исполняет сценарии, отдает команды устройствам")
    Container(sessionManagement, "Управление сессией", "Управление пользовательской сессией, контроль доступа")
    Container(locationManagement, "Микросервис управления локациями")
    ContainerDb(locationsDb, "Locations DB")
}

Container(locationManagement, "Микросервис управления локациями") {
    Component(apiLayer, "API", "Слой API для управления локациями")
    Component(serviceLayer, "LocationService", "Слой бизнес-логики")
    Component(locationRepository, "LocationRepository", "Репозиторий для работы с БД")
}

Rel(loadBalancer, apiLayer, "Создает и редактирует локации по запросу пользователя")
Rel(scenarioEngine, apiLayer, "Запрашивает локации")
Rel(apiLayer, sessionManagement, "Авторизует операцию пользователя")
Rel(apiLayer, serviceLayer, "Валидирует запрос и перенаправляет его в сервисный слой")
Rel(serviceLayer, locationRepository, "Сохраняет/изменяет/читает данные в БД")
Rel(locationRepository, locationsDb, "Сохраняет/изменяет/читает данные в БД")

@enduml