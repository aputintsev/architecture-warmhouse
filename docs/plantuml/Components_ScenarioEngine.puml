@startuml
title Scenario Engine Component Diagram

top to bottom direction

!include <C4/C4_Component>

Container_Boundary(smartHomeSystem, "SmartHome System") {
    Container(scenarioEngine, "Движок сценариев", "Исполняет сценарии, отдает команды устройствам")
    Container(scenarioManagement, "Управление сценариями", "Создание/редактирование сценариев")
    Container(deviceManagement, "Управление устройствами", "Создание/удаление устройств, изменение состояния, получение данных")
}

Container(scenarioEngine, "Микросервис исполнения сценариев") {
    Component(cronTask, "CronTask", "Задача по расписанию")
    ComponentQueue(queue, "Очередь сценариев", "Очередь сценариев на исполнение")
    Component(scenarioProcessor, "Обработчик сценариев", "Исполняет сценарии")
}

Rel(cronTask, scenarioManagement, "Читает сценарии")
Rel(cronTask, queue, "Кладет сценарий в очередь")
Rel(queue, scenarioProcessor, "Читает сценарий из очереди")
Rel(scenarioProcessor, deviceManagement, "Читает показания устройств, управляет устройствами")

@enduml